@model List<MediCore.Models.User>
@{
    Layout = "_Layout";
    ViewData["Title"] = "All Staff";
    string roleFilter = ViewBag.RoleFilter ?? "";
    string searchFilter = ViewBag.SearchFilter ?? "";
}

<p class="page-s">Manage all active and inactive staff accounts.</p>

<div class="sbox mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Search</label>
            <input name="search" class="form-control" placeholder="Name or email…" value="@searchFilter" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Role</label>
            <select name="role" class="form-select">
                <option value="">All Roles</option>
                @foreach (var r in new[] { "Doctor","Nurse","Receptionist","Admin" })
                {
                    <option value="@r" selected="@(roleFilter == r ? "selected" : null)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a href="/Admin/AllUsers" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2"></i>Staff Accounts</span>
        <span class="stat-l">@Model.Count result(s)</span>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4" style="color:#8faac4;">No staff found.</td></tr>
            }
            @foreach (var u in Model)
            {
                <tr>
                    <td style="color:#8faac4;">@u.Id</td>
                    <td class="fw-semibold">@u.FullName</td>
                    <td style="color:#8faac4;">@u.Email</td>
                    <td>
                        @if (u.Role == "Doctor")          { <span class="pill pill-d">Doctor</span> }
                        else if (u.Role == "Nurse")       { <span class="pill pill-r">Nurse</span> }
                        else if (u.Role == "Receptionist"){ <span class="pill pill-a">Receptionist</span> }
                        else if (u.Role == "Admin")       { <span class="pill" style="background:#ede9fe;color:#5b21b6;">Admin</span> }
                        else                              { <span class="pill pill-x">@u.Role</span> }
                    </td>
                    <td>
                        @if (u.IsActive)
                        { <span class="pill pill-d">Active</span> }
                        else
                        { <span class="pill" style="background:#fee2e2;color:#991b1b;">Inactive</span> }
                    </td>
                    <td style="color:#8faac4;">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <form asp-action="ToggleUser" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") me-1" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                <i class="bi bi-@(u.IsActive ? "pause-circle" : "play-circle")"></i>
                            </button>
                        </form>
                        @if (u.Role != "Admin")
                        {
                        <form asp-action="DeleteUser" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this user permanently?')" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
