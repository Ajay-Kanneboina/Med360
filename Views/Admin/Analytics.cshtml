@{
    Layout = "_Layout";
    ViewData["Title"] = "Analytics & Reporting";
    int totalPatients   = ViewBag.TotalPatients   ?? 0;
    int totalRecords    = ViewBag.TotalRecords     ?? 0;
    int totalComplaints = ViewBag.TotalComplaints  ?? 0;
    int resolved        = ViewBag.ResolvedComplaints ?? 0;
    int totalStaff      = ViewBag.TotalStaff       ?? 0;
    int male            = ViewBag.MaleCount        ?? 0;
    int female          = ViewBag.FemaleCount      ?? 0;
    int other           = ViewBag.OtherGender      ?? 0;
    int activeComp      = ViewBag.ActiveComplaints   ?? 0;
    int reviewedComp    = ViewBag.ReviewedComplaints ?? 0;
    int closedComp      = ViewBag.ClosedComplaints   ?? 0;
    int doctors         = ViewBag.DoctorCount      ?? 0;
    int nurses          = ViewBag.NurseCount       ?? 0;
    int receptionists   = ViewBag.ReceptionistCount ?? 0;
    int pTotal          = male + female + other;
}

<p class="page-s">Key performance indicators and operational health of MediCore360.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n text-primary">@totalPatients</div><div class="stat-l">Total Patients</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n" style="color:#0f766e;">@totalRecords</div><div class="stat-l">Medical Records</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n" style="color:#b45309;">@totalComplaints</div><div class="stat-l">Total Complaints</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n" style="color:#166534;">@resolved</div><div class="stat-l">Resolved Complaints</div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="sbox h-100">
            <div class="slabel">Patient Gender Distribution</div>
            @{
                double mPct = pTotal > 0 ? Math.Round(male   * 100.0 / pTotal, 1) : 0;
                double fPct = pTotal > 0 ? Math.Round(female * 100.0 / pTotal, 1) : 0;
                double oPct = pTotal > 0 ? Math.Round(other  * 100.0 / pTotal, 1) : 0;
            }
            <div class="mb-2">
                <div class="d-flex justify-content-between mb-1" style="font-size:.83rem;"><span>Male</span><span class="fw-semibold">@male (@mPct%)</span></div>
                <div class="progress mb-2" style="height:8px;"><div class="progress-bar" style="width:@mPct%;background:#1e2d45;"></div></div>
                <div class="d-flex justify-content-between mb-1" style="font-size:.83rem;"><span>Female</span><span class="fw-semibold">@female (@fPct%)</span></div>
                <div class="progress mb-2" style="height:8px;"><div class="progress-bar" style="width:@fPct%;background:#7c3aed;"></div></div>
                <div class="d-flex justify-content-between mb-1" style="font-size:.83rem;"><span>Other / Not Specified</span><span class="fw-semibold">@other (@oPct%)</span></div>
                <div class="progress" style="height:8px;"><div class="progress-bar bg-secondary" style="width:@oPct%;"></div></div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="sbox h-100">
            <div class="slabel">Complaint Breakdown</div>
            @{
                int cTotal = activeComp + reviewedComp + closedComp;
                double aPct = cTotal > 0 ? Math.Round(activeComp   * 100.0 / cTotal, 1) : 0;
                double rPct = cTotal > 0 ? Math.Round(reviewedComp * 100.0 / cTotal, 1) : 0;
                double clPct= cTotal > 0 ? Math.Round(closedComp   * 100.0 / cTotal, 1) : 0;
            }
            <div class="irow"><span class="ilbl">Active</span>
                <div class="d-flex align-items-center gap-2">
                    <div class="progress" style="width:80px;height:6px;"><div class="progress-bar bg-warning" style="width:@aPct%;"></div></div>
                    <span class="fw-semibold">@activeComp</span>
                </div>
            </div>
            <div class="irow"><span class="ilbl">Reviewed</span>
                <div class="d-flex align-items-center gap-2">
                    <div class="progress" style="width:80px;height:6px;"><div class="progress-bar bg-success" style="width:@rPct%;"></div></div>
                    <span class="fw-semibold">@reviewedComp</span>
                </div>
            </div>
            <div class="irow"><span class="ilbl">Closed</span>
                <div class="d-flex align-items-center gap-2">
                    <div class="progress" style="width:80px;height:6px;"><div class="progress-bar bg-secondary" style="width:@clPct%;"></div></div>
                    <span class="fw-semibold">@closedComp</span>
                </div>
            </div>
            @if (cTotal > 0)
            {
                <div class="mt-3 p-2 rounded" style="background:#f0fdf4;font-size:.82rem;color:#166534;">
                    <i class="bi bi-check-circle me-1"></i>
                    Resolution rate: <strong>@Math.Round((reviewedComp + closedComp) * 100.0 / cTotal, 1)%</strong>
                </div>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="sbox h-100">
            <div class="slabel">Active Staff by Role</div>
            <div class="irow"><span class="ilbl"><i class="bi bi-person-badge me-1 text-success"></i>Doctors</span><span class="fw-bold" style="color:#1e2d45;">@doctors</span></div>
            <div class="irow"><span class="ilbl"><i class="bi bi-heart-pulse me-1" style="color:#7c3aed;"></i>Nurses</span><span class="fw-bold" style="color:#1e2d45;">@nurses</span></div>
            <div class="irow"><span class="ilbl"><i class="bi bi-headset me-1 text-primary"></i>Receptionists</span><span class="fw-bold" style="color:#1e2d45;">@receptionists</span></div>
            <div class="irow" style="border-top:2px solid #eaeef5;margin-top:6px;padding-top:12px;">
                <span class="ilbl">Total Active Staff</span><span class="fw-bold" style="color:#1e2d45;">@totalStaff</span>
            </div>
        </div>
    </div>
</div>

@{
    var bloodGroups = ViewBag.BloodGroups as dynamic ?? new List<dynamic>();
}
@if (bloodGroups != null)
{
<div class="sbox mb-4">
    <div class="slabel">Patient Blood Group Registry</div>
    <div class="row g-2">
    @foreach (var bg in bloodGroups)
    {
        <div class="col-6 col-md-3 col-lg-2">
            <div class="text-center p-2 rounded" style="background:#f6f7fb;border:1px solid #eaeef5;">
                <div class="fw-bold" style="font-size:1.1rem;color:#1e2d45;">@bg.Group</div>
                <div class="stat-l">@bg.Count patient(s)</div>
            </div>
        </div>
    }
    </div>
</div>
}

<div class="sbox" style="background:#f0f9ff;border:1px solid #bae6fd;">
    <div class="slabel" style="color:#0369a1;">Compliance & HIPAA Summary</div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-fill-check text-success" style="font-size:1.4rem;"></i>
                <div>
                    <div class="fw-semibold" style="font-size:.88rem;">Audit Logging</div>
                    <div class="stat-l">All actions recorded</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-lock-fill text-primary" style="font-size:1.4rem;"></i>
                <div>
                    <div class="fw-semibold" style="font-size:.88rem;">RBAC Enforced</div>
                    <div class="stat-l">Role-based access control active</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-check-fill" style="font-size:1.4rem;color:#7c3aed;"></i>
                <div>
                    <div class="fw-semibold" style="font-size:.88rem;">Staff Approval Workflow</div>
                    <div class="stat-l">Admin-gated staff onboarding</div>
                </div>
            </div>
        </div>
    </div>
</div>
