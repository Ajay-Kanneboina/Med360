@model List<MediCore.Models.User>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Pending Staff Approvals";
}

<p class="page-s">Review and approve newly registered staff accounts.</p>

@if (!Model.Any())
{
    <div class="sbox text-center py-5">
        <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem;"></i>
        <div class="mt-3 fw-semibold" style="color:#1e2d45;">No pending approvals</div>
        <div class="stat-l mt-1">All staff registrations are up to date.</div>
        <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary mt-3">Back to Dashboard</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-person-check me-2 text-warning"></i>Pending Approvals</span>
            <span class="badge bg-danger">@Model.Count pending</span>
        </div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Requested</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td style="color:#8faac4;">@u.Email</td>
                        <td>
                            @if (u.Role == "Doctor")         { <span class="pill pill-d">Doctor</span> }
                            else if (u.Role == "Nurse")      { <span class="pill pill-r">Nurse</span> }
                            else if (u.Role == "Receptionist"){ <span class="pill pill-a">Receptionist</span> }
                            else                             { <span class="pill pill-x">@u.Role</span> }
                        </td>
                        <td style="color:#8faac4;">@u.CreatedAt.ToString("dd MMM yyyy, h:mm tt")</td>
                        <td>
                            <form asp-action="Approve" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-sm btn-success me-1"><i class="bi bi-check-lg me-1"></i>Approve</button>
                            </form>
                            <form asp-action="Reject" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject and remove this registration?')">
                                    <i class="bi bi-x-lg me-1"></i>Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
