@model MediCore.Models.Patient
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.FullName;
}

<p class="page-s">Full patient profile, medical history, and complaints.</p>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="sbox">
            <div class="slabel">Demographics</div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:52px;height:52px;border-radius:50%;background:#1e2d45;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:1.3rem;">
                    @Model.FullName[0]
                </div>
                <div>
                    <div class="fw-bold" style="color:#1e2d45;">@Model.FullName</div>
                    <div class="stat-l">Patient #@Model.Id</div>
                </div>
            </div>
            <div class="irow"><span class="ilbl">Date of Birth</span><span>@Model.DateOfBirth.ToString("dd MMM yyyy")</span></div>
            <div class="irow"><span class="ilbl">Gender</span><span>@(Model.Gender ?? "—")</span></div>
            <div class="irow"><span class="ilbl">Blood Group</span>
                <span>@(Model.BloodGroup != null ? Model.BloodGroup : "—")</span>
            </div>
            <div class="irow"><span class="ilbl">Phone</span><span>@(Model.Phone ?? "—")</span></div>
            <div class="irow"><span class="ilbl">Email</span><span>@(Model.Email ?? "—")</span></div>
            <div class="irow"><span class="ilbl">Address</span><span>@(Model.Address ?? "—")</span></div>
            <div class="irow"><span class="ilbl">Emergency Contact</span><span>@(Model.EmergencyContact ?? "—")</span></div>
            <div class="irow"><span class="ilbl">Registered</span><span>@Model.RegisteredOn.ToString("dd MMM yyyy")</span></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.MedicalHistory))
        {
        <div class="sbox">
            <div class="slabel">Medical History Notes</div>
            <p style="font-size:.87rem;color:#374151;white-space:pre-wrap;">@Model.MedicalHistory</p>
        </div>
        }

        <div class="d-flex gap-2">
            <a href="/Admin/AllPatients" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
            <form asp-action="DeletePatient" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this patient and all records?')">
                    <i class="bi bi-trash me-1"></i>Delete Patient
                </button>
            </form>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-medical me-2 text-primary"></i>Medical Records</span>
                <span class="badge bg-primary">@Model.Records.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Records.Any())
                {
                    <div class="text-center py-4 stat-l">No medical records on file.</div>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Date</th><th>Diagnosis</th><th>Treatment</th><th>Doctor</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Records.OrderByDescending(r => r.VisitDate))
                        {
                            <tr>
                                <td style="color:#8faac4;">@r.VisitDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold">@r.Diagnosis</td>
                                <td>@r.Treatment</td>
                                <td style="color:#8faac4;">@(r.DoctorName ?? "—")</td>
                                <td>
                                    @if (r.Status == "Active")   { <span class="pill pill-d">Active</span> }
                                    else if (r.Status == "Closed"){ <span class="pill pill-x">Closed</span> }
                                    else                          { <span class="pill pill-r">@r.Status</span> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-chat-square-text me-2 text-warning"></i>Complaints</span>
                <span class="badge bg-warning text-dark">@Model.Complaints.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Complaints.Any())
                {
                    <div class="text-center py-4 stat-l">No complaints submitted.</div>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Date</th><th>Description</th><th>Status</th><th>Responded By</th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Complaints.OrderByDescending(c => c.SubmittedAt))
                        {
                            <tr>
                                <td style="color:#8faac4;">@c.SubmittedAt.ToString("dd MMM yyyy")</td>
                                <td>@(c.Description.Length > 70 ? c.Description[..70] + "…" : c.Description)</td>
                                <td>
                                    @if (c.Status == "Reviewed") { <span class="pill pill-d">Reviewed</span> }
                                    else if (c.Status == "Active") { <span class="pill pill-a">Active</span> }
                                    else { <span class="pill pill-x">@c.Status</span> }
                                </td>
                                <td style="color:#8faac4;">@(c.RespondedBy ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
