@model List<MediCore.Models.AppointmentRequest>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Patient Appointment Requests";
}

<p class="page-s">Messages from patients requesting appointments. Book their appointment then mark as handled.</p>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-envelope-check me-2" style="color:#0f766e;"></i>Pending Requests</span>
        <span class="stat-l">@Model.Count unhandled</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size:2rem;color:#99f6e4;"></i>
                <div class="stat-l mt-2">No pending requests. All caught up!</div>
            </div>
        }
        else
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Message</th>
                        <th>Preferred Date</th>
                        <th>Preferred Time</th>
                        <th>Sent</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@r.Patient?.FullName</div>
                        </td>
                        <td style="max-width:220px;">
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:210px;"
                                 title="@r.Message">@r.Message</div>
                        </td>
                        <td class="stat-l">@(r.PreferredDate ?? "—")</td>
                        <td class="stat-l">@(r.PreferredTime ?? "—")</td>
                        <td class="stat-l">@r.SentAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="/Receptionist/BookAppointment?requestId=@r.Id&patientId=@r.PatientId"
                                   class="btn btn-sm btn-primary" style="font-size:.75rem;">
                                    <i class="bi bi-calendar-plus me-1"></i>Book
                                </a>
                                <form method="post" action="/Receptionist/HandleRequest">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" style="font-size:.75rem;">
                                        <i class="bi bi-check me-1"></i>Done
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
