@using MediCore.Models
@model List<Appointment>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Appointments";
    var stats = ViewBag.Stats as MediCore.Services.AppointmentStats;
}

<p class="page-s">Manage all patient-doctor appointments</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n text-primary">@(stats?.Total ?? 0)</div><div class="stat-l"><i class="bi bi-calendar2 me-1"></i>Total</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n" style="color:#065f46;">@(stats?.Today ?? 0)</div><div class="stat-l"><i class="bi bi-calendar-check me-1"></i>Today</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n" style="color:#1d4ed8;">@(stats?.Scheduled ?? 0)</div><div class="stat-l"><i class="bi bi-clock me-1"></i>Upcoming</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="stat-n text-danger">@(stats?.Cancelled ?? 0)</div><div class="stat-l"><i class="bi bi-x-circle me-1"></i>Cancelled</div></div></div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" action="/Appointment/Index" class="d-flex gap-2 align-items-center flex-wrap">
            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search…" value="@ViewBag.SearchFilter" style="max-width:180px;" />
            <input type="date" name="date" class="form-control form-control-sm" value="@ViewBag.DateFilter" style="max-width:150px;" />
            <select name="status" class="form-select form-select-sm" style="max-width:140px;">
                <option value="">All Status</option>
                @foreach (var s in new[] { "Scheduled", "Confirmed", "Completed", "Cancelled", "Rescheduled" })
                {
                    @if ((string)ViewBag.StatusFilter == s) { <option value="@s" selected>@s</option> } else { <option value="@s">@s</option> }
                }
            </select>
            <button class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
            <a href="/Appointment/Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            <a href="/Appointment/Book" class="btn btn-sm btn-success ms-auto"><i class="bi bi-plus-lg me-1"></i>Book</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x" style="font-size:2rem;opacity:.3;"></i>
                <p class="mt-2">No appointments found.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th class="ps-3">#</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var pillClass = "pill-a";
                        if (a.Status == "Confirmed") pillClass = "pill-d";
                        else if (a.Status == "Completed") pillClass = "pill-r";
                        else if (a.Status == "Cancelled") pillClass = "pill-x";

                        <tr>
                            <td class="ps-3 text-muted small">@a.Id</td>
                            <td class="fw-semibold small">@a.Patient?.FullName</td>
                            <td class="small">Dr. @a.Doctor?.FullName</td>
                            <td class="small">@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td class="small">@a.TimeSlot</td>
                            <td><span class="pill @pillClass">@a.Status</span></td>
                            <td>
                                @if (a.Status == "Scheduled")
                                {
                                    <form method="post" action="/Appointment/Confirm" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-outline-success py-0 px-2" style="font-size:.75rem;">Confirm</button>
                                    </form>
                                }
                                @if (a.Status == "Confirmed")
                                {
                                    <form method="post" action="/Appointment/Complete" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:.75rem;">Done</button>
                                    </form>
                                }
                                @if (a.Status != "Cancelled" && a.Status != "Completed")
                                {
                                    <form method="post" action="/Appointment/Cancel" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <input type="hidden" name="reason" value="Staff cancelled" />
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:.75rem;">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
