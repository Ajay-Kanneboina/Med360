@*
    _PatientLayout.cshtml — patient portal layout with sidebar UI that matches
    the admin/doctor layout structure. All styles inlined; no external CSS.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — My Health</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        /* =====================================================
           Patient portal — sidebar layout mirroring staff UI.
           Only the accent palette differs (green vs navy) to
           visually distinguish patients from clinical staff.
           ===================================================== */

        body {
            background: #f6f7fb;
            font-family: 'Segoe UI', sans-serif;
            font-size: 14px;
            margin: 0;
        }

        /* Sidebar */
        .sidebar {
            width: 210px;
            background: #1e2d45;
            min-height: 100vh;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            display: flex;
            flex-direction: column;
        }
        .sb-logo {
            padding: 16px 18px;
            border-bottom: 1px solid #2c3f5c;
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .sb-grp {
            padding: 12px 18px 3px;
            font-size: .61rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #5578a0;
        }
        .sb-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 14px;
            margin: 1px 8px;
            border-radius: 6px;
            color: #7a9cc0;
            text-decoration: none;
            font-size: .85rem;
            transition: background .15s;
        }
        .sb-link:hover { background: #2c3f5c; color: #fff; }
        .sb-on         { background: #2c3f5c; color: #fff; }
        .sb-foot {
            padding: 14px 16px;
            border-top: 1px solid #2c3f5c;
            margin-top: auto;
        }
        .sb-user { color: #7a9cc0; font-size: .79rem; margin-bottom: 8px; }
        .sb-user strong { color: #fff; display: block; }

        /* Topbar */
        .topbar {
            position: fixed;
            left: 210px; right: 0; top: 0;
            height: 50px;
            background: #fff;
            border-bottom: 1px solid #eaeef5;
            display: flex;
            align-items: center;
            padding: 0 22px;
            z-index: 10;
        }

        /* Main content area */
        .main    { margin-left: 210px; padding-top: 50px; min-height: 100vh; }
        .content { padding: 22px; }

        /* Page headings */
        .page-h { font-size: 1.1rem; font-weight: 700; color: #1e2d45; margin-bottom: 2px; }
        .page-s { font-size: .81rem; color: #8faac4; margin-bottom: 18px; }

        /* Cards */
        .card        { border: none; border-radius: 8px; box-shadow: 0 1px 5px rgba(0,0,0,.06); }
        .card-header {
            background: #fff;
            border-bottom: 1px solid #eaeef5;
            font-weight: 600;
            font-size: .9rem;
            border-radius: 8px 8px 0 0 !important;
            padding: 10px 16px;
        }

        /* Stat boxes (used on the patient dashboard) */
        .stat   { background: #fff; border-radius: 8px; padding: 16px 18px; box-shadow: 0 1px 5px rgba(0,0,0,.06); }
        .stat-n { font-size: 1.6rem; font-weight: 700; color: #1e2d45; }
        .stat-l { font-size: .77rem; color: #8faac4; }

        /* Stat tiles (used for condensed summary pills) */
        .tile {
            background: #fff;
            border-radius: 8px;
            padding: 16px 18px;
            box-shadow: 0 1px 5px rgba(0,0,0,.06);
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .tile-ic {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        .tile-n { font-size: 1.5rem; font-weight: 700; color: #1e2d45; line-height: 1; }
        .tile-l { font-size: .77rem; color: #8faac4; margin-top: 2px; }

        /* Info boxes */
        .sbox   { background: #fff; border-radius: 8px; padding: 18px; box-shadow: 0 1px 5px rgba(0,0,0,.06); margin-bottom: 16px; }
        .slabel {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: #8faac4;
            border-bottom: 1px solid #f0f3f8;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }

        /* Tables */
        .table { font-size: .86rem; }
        .table thead th { background: #f6f7fb; color: #6b7fa3; font-weight: 600; border-bottom: 2px solid #eaeef5; }
        .table td { border-bottom: 1px solid #f0f3f8; vertical-align: middle; }
        .table tr:last-child td { border-bottom: none; }

        /* Info rows */
        .irow {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            border-bottom: 1px solid #f0f3f8;
            font-size: .87rem;
        }
        .irow:last-child { border-bottom: none; }
        .ilbl { color: #8faac4; font-weight: 600; }

        /* Pills */
        .pill   { border-radius: 20px; padding: 2px 10px; font-size: .74rem; font-weight: 600; }
        .pill-a { background: #fef9c3; color: #854d0e; }
        .pill-r { background: #dbeafe; color: #1d4ed8; }
        .pill-d { background: #dcfce7; color: #166534; }
        .pill-x { background: #f1f5f9; color: #475569; }

        /* Response box */
        .resp-box {
            background: #f0fdf4;
            border: 1px solid #a7f3d0;
            border-radius: 8px;
            padding: 14px 16px;
            font-size: .88rem;
        }

        /* Forms */
        .form-label { font-weight: 600; font-size: .79rem; color: #4a5568; margin-bottom: 4px; }
        .form-control, .form-select {
            border: 1px solid #dde3ee;
            border-radius: 6px;
            font-size: .87rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #1e2d45;
            box-shadow: 0 0 0 3px rgba(30,45,69,.1);
            outline: none;
        }

        /* Primary patient action button — navy, matches admin/doctor.
           (Named btn-g for backwards-compatibility across patient views
           that previously used a green palette.) */
        .btn-g {
            background: #1e2d45;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 8px 20px;
            font-weight: 600;
            font-size: .88rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }
        .btn-g:hover { background: #16233a; color: #fff; }

        /* Alerts */
        .alert { border: none; border-radius: 7px; font-size: .86rem; }
    </style>
</head>
<body>
@{
    var pname = Context.Session.GetString("UserName") ?? "";
    var ppath = Context.Request.Path.Value ?? "";
    bool isPatient = Context.Session.GetString("UserRole") == "Patient";
}

@if (isPatient)
{
    <aside class="sidebar">
        <div class="sb-logo">
            <i class="bi bi-heart-pulse-fill"></i> My Health
        </div>
        <nav style="flex:1;padding:8px 0;overflow-y:auto;">
            <div class="sb-grp">Overview</div>
            <a href="/Patient/Dashboard"
               class="sb-link @(ppath == "/Patient/Dashboard" ? "sb-on" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <div class="sb-grp">Clinical</div>
            <a href="/Patient/MyRecords"
               class="sb-link @(ppath.Contains("/Patient/MyRecords") || ppath.Contains("/Patient/RecordDetail") ? "sb-on" : "")">
                <i class="bi bi-file-medical"></i> My Records
            </a>
            <a href="/Patient/MyComplaints"
               class="sb-link @(ppath.Contains("/Patient/MyComplaints") || ppath.Contains("/Patient/SubmitComplaint") || ppath.Contains("/Patient/EditComplaint") ? "sb-on" : "")">
                <i class="bi bi-chat-square-text"></i> My Problems
            </a>
            <div class="sb-grp">Account</div>
            <a href="/Patient/MyProfile"
               class="sb-link @(ppath.Contains("/Patient/MyProfile") || ppath.Contains("/Patient/EditProfile") ? "sb-on" : "")">
                <i class="bi bi-person-vcard"></i> My Profile
            </a>
        </nav>
        <div class="sb-foot">
            <div class="sb-user">
                <strong>@pname</strong>
                Patient
            </div>
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100"
                        style="font-size:.8rem;color:#7a9cc0;border-color:#2c3f5c;">
                    <i class="bi bi-box-arrow-left me-1"></i>Sign Out
                </button>
            </form>
        </div>
    </aside>

    <header class="topbar">
        <span style="font-weight:600;color:#1e2d45;font-size:.93rem;">@ViewData["Title"]</span>
    </header>
}

<div class="@(isPatient ? "main" : "")">
    <div class="@(isPatient ? "content" : "")">
        @if (TempData["Success"] != null)
        {
            <div class="alert mb-3" style="background:#f0fdf4;color:#166534;">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
