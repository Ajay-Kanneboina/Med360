@*
    _PatientLayout.cshtml — patient portal layout with sidebar UI that matches
    the admin/doctor layout structure. All styles inlined; no external CSS.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — MediCore360</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            background: #f0fdfa;
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 14px;
            margin: 0;
        }

        /* Sidebar — teal theme */
        .sidebar {
            width: 220px;
            background: #134e4a;
            min-height: 100vh;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            display: flex;
            flex-direction: column;
        }
        .sb-logo {
            padding: 16px 18px;
            border-bottom: 1px solid #1a6b65;
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .95rem;
            letter-spacing: .3px;
        }
        .sb-grp {
            padding: 12px 18px 3px;
            font-size: .61rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #4db6ad;
        }
        .sb-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 14px;
            margin: 1px 8px;
            border-radius: 7px;
            color: #99d6d1;
            text-decoration: none;
            font-size: .85rem;
            transition: background .15s;
        }
        .sb-link:hover { background: #1a6b65; color: #fff; }
        .sb-on         { background: #0f766e; color: #fff; }
        .sb-foot {
            padding: 14px 16px;
            border-top: 1px solid #1a6b65;
            margin-top: auto;
        }
        .sb-user { color: #99d6d1; font-size: .79rem; margin-bottom: 8px; }
        .sb-user strong { color: #fff; display: block; }

        /* Topbar */
        .topbar {
            position: fixed;
            left: 220px; right: 0; top: 0;
            height: 52px;
            background: #fff;
            border-bottom: 2px solid #ccfbf1;
            display: flex;
            align-items: center;
            padding: 0 24px;
            z-index: 10;
        }

        /* Main content area */
        .main    { margin-left: 220px; padding-top: 52px; min-height: 100vh; }
        .content { padding: 24px; }

        /* Page headings */
        .page-h { font-size: 1.1rem; font-weight: 700; color: #134e4a; margin-bottom: 2px; }
        .page-s { font-size: .81rem; color: #6b9e99; margin-bottom: 18px; }

        /* Cards */
        .card        { border: none; border-radius: 10px; box-shadow: 0 1px 6px rgba(0,0,0,.07); }
        .card-header {
            background: #fff;
            border-bottom: 1px solid #d1fae5;
            font-weight: 600;
            font-size: .9rem;
            border-radius: 10px 10px 0 0 !important;
            padding: 11px 16px;
        }

        /* Stat boxes */
        .stat   { background: #fff; border-radius: 10px; padding: 16px 18px; box-shadow: 0 1px 6px rgba(0,0,0,.07); }
        .stat-n { font-size: 1.6rem; font-weight: 700; color: #134e4a; }
        .stat-l { font-size: .77rem; color: #6b9e99; }

        /* Stat tiles */
        .tile {
            background: #fff;
            border-radius: 10px;
            padding: 16px 18px;
            box-shadow: 0 1px 6px rgba(0,0,0,.07);
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .tile-ic {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        .tile-n { font-size: 1.5rem; font-weight: 700; color: #134e4a; line-height: 1; }
        .tile-l { font-size: .77rem; color: #6b9e99; margin-top: 2px; }

        /* Info boxes */
        .sbox   { background: #fff; border-radius: 10px; padding: 18px; box-shadow: 0 1px 6px rgba(0,0,0,.07); margin-bottom: 16px; }
        .slabel {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: #6b9e99;
            border-bottom: 1px solid #f0fdf9;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }

        /* Tables */
        .table { font-size: .86rem; }
        .table thead th { background: #f0fdfa; color: #0f766e; font-weight: 600; border-bottom: 2px solid #ccfbf1; }
        .table td { border-bottom: 1px solid #f0fdf9; vertical-align: middle; }
        .table tr:last-child td { border-bottom: none; }

        /* Info rows */
        .irow {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            border-bottom: 1px solid #f0fdf9;
            font-size: .87rem;
        }
        .irow:last-child { border-bottom: none; }
        .ilbl { color: #6b9e99; font-weight: 600; }

        /* Pills */
        .pill   { border-radius: 20px; padding: 2px 10px; font-size: .74rem; font-weight: 600; }
        .pill-a { background: #fef9c3; color: #854d0e; }
        .pill-r { background: #ccfbf1; color: #0f766e; }
        .pill-d { background: #dcfce7; color: #166534; }
        .pill-x { background: #f1f5f9; color: #475569; }

        /* Response box */
        .resp-box {
            background: #f0fdfa;
            border: 1px solid #99f6e4;
            border-radius: 8px;
            padding: 14px 16px;
            font-size: .88rem;
        }

        /* Forms */
        .form-label { font-weight: 600; font-size: .79rem; color: #374151; margin-bottom: 4px; }
        .form-control, .form-select {
            border: 1px solid #99f6e4;
            border-radius: 7px;
            font-size: .87rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15,118,110,.12);
            outline: none;
        }

        /* Patient action button */
        .btn-g {
            background: #0f766e;
            color: #fff;
            border: none;
            border-radius: 7px;
            padding: 8px 20px;
            font-weight: 600;
            font-size: .88rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }
        .btn-g:hover { background: #0d6b63; color: #fff; }

        /* Alerts */
        .alert { border: none; border-radius: 8px; font-size: .86rem; }
    </style>
</head>
<body>
@{
    var pname = Context.Session.GetString("UserName") ?? "";
    var ppath = Context.Request.Path.Value ?? "";
    bool isPatient = Context.Session.GetString("UserRole") == "Patient";
}

@if (isPatient)
{
    <aside class="sidebar">
        <div class="sb-logo">
            <img src="/images/logo.svg" width="26" height="26" style="border-radius:50%;" /> MediCore360
        </div>
        <nav style="flex:1;padding:8px 0;overflow-y:auto;">
            <div class="sb-grp">Overview</div>
            <a href="/Patient/Dashboard"
               class="sb-link @(ppath == "/Patient/Dashboard" ? "sb-on" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <div class="sb-grp">Clinical</div>
            <a href="/Patient/MyRecords"
               class="sb-link @(ppath.Contains("/Patient/MyRecords") || ppath.Contains("/Patient/RecordDetail") ? "sb-on" : "")">
                <i class="bi bi-file-medical"></i> My Records
            </a>
            <a href="/Patient/MyComplaints"
               class="sb-link @(ppath.Contains("/Patient/MyComplaints") || ppath.Contains("/Patient/SubmitComplaint") || ppath.Contains("/Patient/EditComplaint") ? "sb-on" : "")">
                <i class="bi bi-chat-square-text"></i> My Problems
            </a>
            <div class="sb-grp">Account</div>
            <a href="/Patient/MyProfile"
               class="sb-link @(ppath.Contains("/Patient/MyProfile") || ppath.Contains("/Patient/EditProfile") ? "sb-on" : "")">
                <i class="bi bi-person-vcard"></i> My Profile
            </a>
        </nav>
        <div class="sb-foot">
            <div class="sb-user">
                <strong>@pname</strong>
                Patient
            </div>
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100"
                        style="font-size:.8rem;color:#99d6d1;border-color:#1a6b65;">
                    <i class="bi bi-box-arrow-left me-1"></i>Sign Out
                </button>
            </form>
        </div>
    </aside>

    <header class="topbar">
        <span style="font-weight:600;color:#134e4a;font-size:.93rem;">@ViewData["Title"]</span>
    </header>
}

<div class="@(isPatient ? "main" : "")">
    <div class="@(isPatient ? "content" : "")">
        @if (TempData["Success"] != null)
        {
            <div class="alert mb-3" style="background:#f0fdf4;color:#166534;">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
