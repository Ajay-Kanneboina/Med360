<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — MediCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            background: #f0fdfa;
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 14px;
            margin: 0;
        }

        .sidebar {
            width: 220px;
            background: #134e4a;
            min-height: 100vh;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            display: flex;
            flex-direction: column;
        }
        .sb-logo {
            padding: 16px 18px;
            border-bottom: 1px solid #1a6b65;
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .95rem;
            letter-spacing: .3px;
        }
        .sb-grp {
            padding: 12px 18px 3px;
            font-size: .61rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #4db6ad;
        }
        .sb-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 14px;
            margin: 1px 8px;
            border-radius: 7px;
            color: #99d6d1;
            text-decoration: none;
            font-size: .85rem;
            transition: background .15s;
        }
        .sb-link:hover { background: #1a6b65; color: #fff; }
        .sb-on         { background: #0f766e; color: #fff; }
        .sb-foot {
            padding: 14px 16px;
            border-top: 1px solid #1a6b65;
            margin-top: auto;
        }
        .sb-user { color: #99d6d1; font-size: .79rem; margin-bottom: 8px; }
        .sb-user strong { color: #fff; display: block; }

        .topbar {
            position: fixed;
            left: 220px; right: 0; top: 0;
            height: 52px;
            background: #fff;
            border-bottom: 2px solid #ccfbf1;
            display: flex;
            align-items: center;
            padding: 0 24px;
            z-index: 10;
        }

        .main    { margin-left: 220px; padding-top: 52px; min-height: 100vh; }
        .content { padding: 24px; }

        .page-h { font-size: 1.1rem; font-weight: 700; color: #134e4a; margin-bottom: 2px; }
        .page-s { font-size: .81rem; color: #6b9e99; margin-bottom: 18px; }

        .card        { border: none; border-radius: 10px; box-shadow: 0 1px 6px rgba(0,0,0,.07); }
        .card-header {
            background: #fff;
            border-bottom: 1px solid #d1fae5;
            font-weight: 600;
            font-size: .9rem;
            border-radius: 10px 10px 0 0 !important;
            padding: 11px 16px;
        }

        .stat   { background: #fff; border-radius: 10px; padding: 16px 18px; box-shadow: 0 1px 6px rgba(0,0,0,.07); }
        .stat-n { font-size: 1.6rem; font-weight: 700; color: #134e4a; }
        .stat-l { font-size: .77rem; color: #6b9e99; }

        .sbox   { background: #fff; border-radius: 10px; padding: 18px; box-shadow: 0 1px 6px rgba(0,0,0,.07); margin-bottom: 16px; }
        .slabel {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: #6b9e99;
            border-bottom: 1px solid #f0fdf9;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }

        .table { font-size: .86rem; }
        .table thead th {
            background: #f0fdfa;
            color: #0f766e;
            font-weight: 600;
            border-bottom: 2px solid #ccfbf1;
        }
        .table td { border-bottom: 1px solid #f0fdf9; vertical-align: middle; }
        .table tr:last-child td { border-bottom: none; }

        .irow {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            border-bottom: 1px solid #f0fdf9;
            font-size: .87rem;
        }
        .irow:last-child { border-bottom: none; }
        .ilbl { color: #6b9e99; font-weight: 600; }

        .pill   { border-radius: 20px; padding: 2px 10px; font-size: .74rem; font-weight: 600; }
        .pill-a { background: #fef9c3; color: #854d0e; }
        .pill-r { background: #ccfbf1; color: #0f766e; }
        .pill-d { background: #dcfce7; color: #166534; }
        .pill-x { background: #f1f5f9; color: #475569; }

        .form-label { font-weight: 600; font-size: .79rem; color: #374151; margin-bottom: 4px; }
        .form-control, .form-select {
            border: 1px solid #99f6e4;
            border-radius: 7px;
            font-size: .87rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15,118,110,.12);
            outline: none;
        }

        .btn-primary       { background: #0f766e; border-color: #0f766e; }
        .btn-primary:hover { background: #0d6b63; border-color: #0d6b63; }

        .alert { border: none; border-radius: 8px; font-size: .86rem; }
    </style>
</head>
<body>
@{
    var uname = Context.Session.GetString("UserName") ?? "";
    var urole = Context.Session.GetString("UserRole") ?? "";
    var upath = Context.Request.Path.Value ?? "";
    var uqs   = Context.Request.QueryString.Value ?? "";
    bool isStaff = !string.IsNullOrEmpty(uname) && urole != "Patient";
    int nc = 0;
    if (isStaff)
    {
        var ncObj = ViewBag.NewComplaints;
        if (ncObj != null) nc = (int)ncObj;
    }
}

@if (isStaff)
{
    <aside class="sidebar">
        <div class="sb-logo">
            <img src="/images/logo.svg" width="34" height="34" style="border-radius:50%;flex-shrink:0;" onerror="this.style.display='none'" /> MediCore360
        </div>
        <nav style="flex:1;padding:8px 0;overflow-y:auto;">
        @if (urole == "Admin")
        {
            <div class="sb-grp">Overview</div>
            <a href="/Admin/Index" class="sb-link @(upath=="/Admin/Index"||upath=="/Admin" ? "sb-on" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <div class="sb-grp">User Management</div>
            <a href="/Admin/PendingUsers" class="sb-link @(upath.StartsWith("/Admin/PendingUsers") ? "sb-on" : "")">
                <i class="bi bi-person-check"></i> Pending Approvals
                @{ var pend = ViewBag.PendingApprovals as int?; if (pend > 0) { <span class="badge bg-warning text-dark ms-auto">@pend</span> } }
            </a>
            <a href="/Admin/AllUsers" class="sb-link @(upath.StartsWith("/Admin/AllUsers") ? "sb-on" : "")">
                <i class="bi bi-people"></i> All Staff
            </a>
            <div class="sb-grp">Patients</div>
            <a href="/Admin/AllPatients" class="sb-link @(upath.StartsWith("/Admin/AllPatients") ? "sb-on" : "")">
                <i class="bi bi-person-vcard"></i> All Patients
            </a>
            <div class="sb-grp">Clinical</div>
            <a href="/Admin/AllRecords" class="sb-link @(upath.StartsWith("/Admin/AllRecords") ? "sb-on" : "")">
                <i class="bi bi-file-medical"></i> Medical Records
            </a>
            <a href="/Admin/AllComplaints" class="sb-link @(upath.StartsWith("/Admin/AllComplaints") ? "sb-on" : "")">
                <i class="bi bi-chat-square-text"></i> Complaints
                @if (nc > 0) { <span class="badge bg-danger ms-auto">@nc</span> }
            </a>
            <div class="sb-grp">Appointments</div>
            <a href="/Appointment/Index" class="sb-link @(upath=="/Appointment/Index" || upath=="/Appointment" ? "sb-on" : "")">
                <i class="bi bi-calendar2-check"></i> All Appointments
            </a>
            <a href="/Appointment/Book" class="sb-link @(upath.StartsWith("/Appointment/Book") ? "sb-on" : "")">
                <i class="bi bi-calendar2-plus"></i> Book Appointment
            </a>
            <div class="sb-grp">Appointments</div>
            <a href="/Admin/Appointments" class="sb-link @(upath.StartsWith("/Admin/Appointments") ? "sb-on" : "")">
                <i class="bi bi-calendar2-check"></i> Appointments
            </a>
            <div class="sb-grp">Compliance</div>
            <a href="/Admin/AuditLog" class="sb-link @(upath.StartsWith("/Admin/AuditLog") ? "sb-on" : "")">
                <i class="bi bi-shield-check"></i> Audit Log
            </a>
            <a href="/Admin/Analytics" class="sb-link @(upath.StartsWith("/Admin/Analytics") ? "sb-on" : "")">
                <i class="bi bi-bar-chart-line"></i> Analytics
            </a>
        }
        else if (urole == "Doctor")
        {
            <div class="sb-grp">Overview</div>
            <a href="/Doctor/Dashboard" class="sb-link @(upath.StartsWith("/Doctor/Dashboard") ? "sb-on" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <div class="sb-grp">Patients</div>
            <a href="/Doctor/Patients" class="sb-link @(upath.StartsWith("/Doctor/Patients") ? "sb-on" : "")">
                <i class="bi bi-people"></i> All Patients
            </a>
            <div class="sb-grp">Appointments</div>
            <a href="/Doctor/MyAppointments" class="sb-link @(upath.StartsWith("/Doctor/MyAppointments") ? "sb-on" : "")">
                <i class="bi bi-calendar2-check"></i> My Appointments
            </a>
            <a href="/Doctor/MyAvailability" class="sb-link @(upath.StartsWith("/Doctor/MyAvailability") ? "sb-on" : "")">
                <i class="bi bi-clock-history"></i> My Availability
            </a>
            <div class="sb-grp">Complaints</div>
            <a href="/Doctor/Complaints" class="sb-link @(upath=="/Doctor/Complaints" && !uqs.Contains("filter=unread") ? "sb-on" : "")">
                <i class="bi bi-chat-square-text"></i> All Complaints
                @if (nc > 0) { <span class="badge bg-danger ms-auto">@nc</span> }
            </a>
            <a href="/Doctor/Complaints?filter=unread" class="sb-link @(uqs.Contains("filter=unread") ? "sb-on" : "")">
                <i class="bi bi-envelope-exclamation"></i> Unread
            </a>
        }
        else if (urole == "Nurse")
        {
            <div class="sb-grp">Overview</div>
            <a href="/Nurse/Dashboard" class="sb-link @(upath.StartsWith("/Nurse/Dashboard") ? "sb-on" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <div class="sb-grp">Patients</div>
            <a href="/Doctor/Patients" class="sb-link @(upath.StartsWith("/Doctor/Patients") ? "sb-on" : "")">
                <i class="bi bi-people"></i> All Patients
            </a>
            <div class="sb-grp">Complaints</div>
            <a href="/Doctor/Complaints" class="sb-link @(upath=="/Doctor/Complaints" && !uqs.Contains("filter=unread") ? "sb-on" : "")">
                <i class="bi bi-chat-square-text"></i> All Complaints
                @if (nc > 0) { <span class="badge bg-danger ms-auto">@nc</span> }
            </a>
            <a href="/Doctor/Complaints?filter=unread" class="sb-link @(uqs.Contains("filter=unread") ? "sb-on" : "")">
                <i class="bi bi-envelope-exclamation"></i> Unread
            </a>
        }
        else if (urole == "Receptionist")
        {
            <div class="sb-grp">Overview</div>
            <a href="/Receptionist/Dashboard" class="sb-link @(upath == "/Receptionist/Dashboard" ? "sb-on" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <div class="sb-grp">Appointments</div>
            <a href="/Receptionist/AppointmentRequests" class="sb-link @(upath.StartsWith("/Receptionist/AppointmentRequests") ? "sb-on" : "")">
                <i class="bi bi-envelope-check"></i> Patient Requests
                @{ var pr = ViewBag.PendingRequests as int?; if (pr > 0) { <span class="badge bg-warning text-dark ms-auto">@pr</span> } }
            </a>
            <a href="/Receptionist/BookAppointment" class="sb-link @(upath.StartsWith("/Receptionist/BookAppointment") ? "sb-on" : "")">
                <i class="bi bi-calendar-plus"></i> Book Appointment
            </a>
            <a href="/Receptionist/Appointments" class="sb-link @(upath.StartsWith("/Receptionist/Appointments") ? "sb-on" : "")">
                <i class="bi bi-calendar2-check"></i> All Appointments
            </a>
            <div class="sb-grp">Staff</div>
            <a href="/Receptionist/Doctors" class="sb-link @(upath.StartsWith("/Receptionist/Doctors") ? "sb-on" : "")">
                <i class="bi bi-person-badge"></i> All Doctors
            </a>
            <div class="sb-grp">Patients</div>
            <a href="/Doctor/Patients" class="sb-link @(upath.StartsWith("/Doctor/Patients") ? "sb-on" : "")">
                <i class="bi bi-people"></i> All Patients
            </a>
            <div class="sb-grp">Complaints</div>
            <a href="/Doctor/Complaints" class="sb-link @(upath == "/Doctor/Complaints" && !uqs.Contains("filter=unread") ? "sb-on" : "")">
                <i class="bi bi-chat-square-text"></i> All Complaints
                @if (nc > 0) { <span class="badge bg-danger ms-auto">@nc</span> }
            </a>
        }
        </nav>
        <div class="sb-foot">
            <div class="sb-user">
                <strong>@uname</strong>
                @urole
            </div>
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100" style="font-size:.8rem;color:#99d6d1;border-color:#1a6b65;">
                    <i class="bi bi-box-arrow-left me-1"></i>Sign Out
                </button>
            </form>
        </div>
    </aside>

    <header class="topbar">
        <span style="font-weight:600;color:#134e4a;font-size:.93rem;">@ViewData["Title"]</span>
    </header>
}

<div class="@(isStaff ? "main" : "")">
    <div class="@(isStaff ? "content" : "")">
        @if (TempData["Success"] != null)
        {
            <div class="alert mb-3" style="background:#f0fdf4;color:#166534;">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
