@model List<MediCore.Models.Complaint>
@{
    ViewData["Title"] = "My Problems";
    Layout = "_PatientLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <p class="page-s mb-0">Problems you have submitted to the doctor.</p>
    <a href="/Patient/SubmitComplaint" class="btn-g">
        <i class="bi bi-plus-lg me-1"></i>Report New Problem
    </a>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-chat-square-text" style="font-size:2.5rem;opacity:.3;"></i>
        <p class="mt-3 mb-2 fw-semibold">No problems submitted yet</p>
        <a href="/Patient/SubmitComplaint" class="btn-g" style="padding:6px 14px;font-size:.84rem;">Report a Problem</a>
    </div>
}
else
{
    @foreach (var c in Model)
    {
        <div class="card mb-3" data-complaint="@c.Id">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="pill @(c.Status == "Active" ? "pill-a" : c.Status == "Reviewed" ? "pill-r" : "pill-d") me-2">
                            @c.Status
                        </span>
                        <span class="text-muted" style="font-size:.79rem;">
                            Submitted @c.SubmittedAt.ToString("dd MMM yyyy")
                        </span>
                        @if (c.UpdatedAt.Date != c.SubmittedAt.Date)
                        {
                            <span class="text-muted" style="font-size:.79rem;"> · Updated @c.UpdatedAt.ToString("dd MMM yyyy")</span>
                        }
                    </div>
                    @if (c.Status == "Active")
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary js-edit-toggle"
                                style="font-size:.79rem;">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    }
                </div>

                @* ── View mode ───────────────────────────────── *@
                <div class="js-view">
                    <p class="fw-semibold mb-1" style="font-size:.9rem;">@c.Description</p>
                    @if (!string.IsNullOrEmpty(c.AdditionalNotes))
                    {
                        <p class="text-muted mb-2" style="font-size:.84rem;">@c.AdditionalNotes</p>
                    }
                </div>

                @* ── Edit mode (hidden until Edit clicked) ──── *@
                @if (c.Status == "Active")
                {
                    <form method="post" action="/Patient/EditComplaint/@c.Id" class="js-edit" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <div class="mb-2">
                            <label class="form-label">Main problem or symptom</label>
                            <textarea name="description" class="form-control" rows="4" required>@c.Description</textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Additional details (optional)</label>
                            <textarea name="additionalNotes" class="form-control" rows="2">@c.AdditionalNotes</textarea>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn-g" style="padding:6px 16px;font-size:.84rem;">
                                <i class="bi bi-check-lg me-1"></i>Save Update
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm js-edit-cancel">Cancel</button>
                        </div>
                    </form>
                }

                @* ── Doctor response (always visible below) ── *@
                @if (!string.IsNullOrEmpty(c.DoctorResponse))
                {
                    <div class="resp-box mt-3">
                        <div style="font-size:.78rem;font-weight:600;color:#1e2d45;margin-bottom:4px;">
                            <i class="bi bi-reply me-1"></i>
                            @c.RespondedBy replied on @c.RespondedAt?.ToString("dd MMM yyyy")
                        </div>
                        <div style="font-size:.87rem;">@c.DoctorResponse</div>
                    </div>
                }
            </div>
        </div>
    }
}

<script>
    // Per-card inline edit toggle — no page navigation required.
    document.querySelectorAll('[data-complaint]').forEach(card => {
        const toggle = card.querySelector('.js-edit-toggle');
        const cancel = card.querySelector('.js-edit-cancel');
        const view   = card.querySelector('.js-view');
        const edit   = card.querySelector('.js-edit');
        if (!toggle || !view || !edit) return;

        toggle.addEventListener('click', () => {
            view.style.display = 'none';
            edit.style.display = '';
            toggle.style.display = 'none';
        });
        cancel?.addEventListener('click', () => {
            // Discard unsaved changes — reload resets the textareas.
            location.reload();
        });
    });
</script>
