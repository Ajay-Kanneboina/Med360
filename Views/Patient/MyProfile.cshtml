@model MediCore.Models.Patient
@{
    ViewData["Title"] = "My Profile";
    Layout = "_PatientLayout";
}

<div class="mb-3">
    <h5 class="fw-bold mb-1" style="color:#1e2d45;">My Profile</h5>
    <p class="text-muted mb-0" style="font-size:.83rem;">Your registered health information</p>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header px-3 py-2">Personal Details</div>
            <div class="card-body p-3">
                <div class="irow">
                    <span class="ilbl">Full Name</span>
                    <span>@Model.FullName</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Date of Birth</span>
                    <span>@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Gender</span>
                    <span>@(Model.Gender ?? "—")</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Blood Group</span>
                    <span>@(Model.BloodGroup ?? "—")</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Phone</span>
                    <span>@(Model.Phone ?? "—")</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Email</span>
                    <span>@(Model.Email ?? "—")</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Address</span>
                    <span>@(Model.Address ?? "—")</span>
                </div>
                <div class="irow">
                    <span class="ilbl">Emergency Contact</span>
                    <span>@(Model.EmergencyContact ?? "—")</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header px-3 py-2">Medical History</div>
            <div class="card-body p-3">
                @if (string.IsNullOrWhiteSpace(Model.MedicalHistory))
                {
                    <p class="text-muted mb-0" style="font-size:.86rem;">No prior medical history on record.</p>
                }
                else
                {
                    <p style="font-size:.87rem;line-height:1.75;white-space:pre-line;margin:0;">@Model.MedicalHistory</p>
                }
            </div>
        </div>
    </div>
</div>
