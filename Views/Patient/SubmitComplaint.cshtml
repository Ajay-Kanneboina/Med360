@{
    ViewData["Title"] = "Report a Problem";
    Layout = "_PatientLayout";
}

<div class="mb-3">
    <h5 class="fw-bold mb-1" style="color:#1e2d45;">Report a Problem</h5>
    <p class="text-muted mb-0" style="font-size:.83rem;">Describe what you are experiencing and a doctor will respond.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-3">@ViewBag.Error</div>
}

<form method="post" action="/Patient/SubmitComplaint" style="max-width:680px;">
    @Html.AntiForgeryToken()

    <div class="sbox">
        <div class="slabel">Describe Your Problem</div>
        <div class="mb-3">
            <label class="form-label">What is your main problem or symptom?</label>
            <textarea name="description" class="form-control" rows="5" required></textarea>
        </div>
        <div class="mb-1">
            <label class="form-label">Additional details (optional)</label>
            <textarea name="additionalNotes" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-g">Submit Problem</button>
        <a href="/Patient/MyComplaints" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
