@using MediCore.Models
@{ ViewData["Title"] = "Book Appointment"; Layout = "_PatientLayout";
    var doctors = ViewBag.Doctors as List<User> ?? new();
}
<a href="/Patient/MyAppointments" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left me-1"></i>Back</a>
<div class="card" style="max-width:600px;"><div class="card-header" style="background:#1e2d45;color:#fff;"><i class="bi bi-calendar2-plus me-2"></i>Book Appointment</div>
<div class="card-body">
<form method="post" action="/Patient/BookAppointment">@Html.AntiForgeryToken()
    <input type="hidden" name="doctorId" id="docId"/><input type="hidden" name="timeSlot" id="slotVal"/>
    <label class="form-label">Choose Doctor *</label>
    @foreach (var d in doctors) { var ini = d.FullName.Length > 0 ? d.FullName.Substring(0, 1) : "D";
    <div class="card mb-2 doc-card" style="cursor:pointer;" onclick="pickDoc(@d.Id, this)">
        <div class="card-body py-2 d-flex align-items-center gap-3">
            <div style="width:38px;height:38px;background:#1e2d45;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;">@ini</div>
            <div><div class="fw-semibold small">Dr. @d.FullName</div></div>
            <i class="bi bi-circle text-muted ms-auto chk" id="chk-@d.Id"></i>
        </div>
    </div> }
    <label class="form-label mt-2">Date *</label>
    <input type="date" name="appointmentDate" id="dateSel" class="form-control form-control-sm mb-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" style="max-width:200px;"/>
    <label class="form-label">Time Slot *</label>
    <div id="slotGrid" class="d-flex flex-wrap gap-2 mb-3"><span class="text-muted small">Pick doctor &amp; date first</span></div>
    <label class="form-label">Notes</label>
    <textarea name="notes" class="form-control form-control-sm mb-3" rows="2" placeholder="Reason for visit…"></textarea>
    <button type="submit" class="btn btn-primary" id="subBtn" disabled><i class="bi bi-check-lg me-1"></i>Confirm Booking</button>
</form></div></div>
<script>
var selDoc=null;
function pickDoc(id,el){document.querySelectorAll('.doc-card').forEach(c=>{c.style.borderColor='';c.querySelector('.chk').className='bi bi-circle text-muted ms-auto chk';});
el.style.borderColor='#1e2d45';el.querySelector('.chk').className='bi bi-check-circle-fill text-primary ms-auto chk';selDoc=id;document.getElementById('docId').value=id;loadSlots();}
document.getElementById('dateSel').onchange=loadSlots;
function loadSlots(){var d=document.getElementById('dateSel').value;if(!selDoc||!d)return;var sg=document.getElementById('slotGrid');sg.innerHTML='<span class="text-muted small">Loading…</span>';
document.getElementById('slotVal').value='';document.getElementById('subBtn').disabled=true;
fetch('/Patient/GetSlots?doctorId='+selDoc+'&date='+d).then(r=>r.json()).then(s=>{if(!s.length){sg.innerHTML='<span class="text-danger small">No slots</span>';return;}
sg.innerHTML='';s.forEach(x=>{var b=document.createElement('button');b.type='button';b.className='btn btn-sm btn-outline-secondary';b.textContent=x;
b.onclick=function(){sg.querySelectorAll('button').forEach(e=>e.classList.remove('btn-primary','text-white'));b.classList.add('btn-primary','text-white');document.getElementById('slotVal').value=x;document.getElementById('subBtn').disabled=false;};sg.appendChild(b);});});}
</script>
