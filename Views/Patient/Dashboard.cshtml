@model MediCore.Models.Patient
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_PatientLayout";
    var lastResp = ViewBag.LastResponse as MediCore.Models.Complaint;
    var recentComplaints = Model?.Complaints.OrderByDescending(c => c.UpdatedAt).Take(4).ToList() ?? new List<MediCore.Models.Complaint>();
}

@if (Model == null)
{
    <div class="card p-4 text-center">
        <i class="bi bi-person-x" style="font-size:2.5rem;color:#94a3b8;"></i>
        <h6 class="mt-3 fw-semibold">No health record linked</h6>
        <p class="text-muted mb-0" style="font-size:.85rem;">Contact the reception desk to link your account.</p>
    </div>
}
else
{
    <div class="mb-3">
        <h5 class="fw-bold mb-1" style="color:#1e2d45;">Hello, @Model.FullName</h5>
        <p class="text-muted mb-0" style="font-size:.84rem;">Here is a summary of your health information.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="tile">
                <div class="tile-ic" style="background:#fef9c3;">
                    <i class="bi bi-chat-square-text" style="color:#854d0e;"></i>
                </div>
                <div>
                    <div class="tile-n">@ViewBag.OpenCount</div>
                    <div class="tile-l">Open Problems</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="tile">
                <div class="tile-ic" style="background:#dbeafe;">
                    <i class="bi bi-check2-circle" style="color:#1d4ed8;"></i>
                </div>
                <div>
                    <div class="tile-n">@ViewBag.ReviewedCount</div>
                    <div class="tile-l">Reviewed</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="tile">
                <div class="tile-ic" style="background:#f0fdf4;">
                    <i class="bi bi-file-medical" style="color:#16a34a;"></i>
                </div>
                <div>
                    <div class="tile-n">@ViewBag.RecordCount</div>
                    <div class="tile-l">Medical Records</div>
                </div>
            </div>
        </div>
    </div>

    @if (lastResp != null)
    {
        <div class="card mb-4">
            <div class="card-header px-3 py-2" style="background:#f0fdf4;">
                <i class="bi bi-reply text-success me-2"></i>Latest Doctor Response
            </div>
            <div class="card-body">
                <p class="text-muted mb-1" style="font-size:.82rem;">
                    Your problem: <em>@lastResp.Description</em>
                </p>
                <div class="resp-box mt-2">
                    <div class="fw-semibold mb-1" style="font-size:.83rem;">
                        @lastResp.RespondedBy — @lastResp.RespondedAt?.ToString("dd MMM yyyy")
                    </div>
                    @lastResp.DoctorResponse
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header px-3 py-2 d-flex justify-content-between align-items-center">
                    <span>My Details</span>
                    <a href="/Patient/MyProfile" style="font-size:.79rem;color:#1e2d45;text-decoration:none;">View all</a>
                </div>
                <div class="card-body p-3">
                    <div class="irow">
                        <span class="ilbl">Date of Birth</span>
                        <span>@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="irow">
                        <span class="ilbl">Gender</span>
                        <span>@(Model.Gender ?? "—")</span>
                    </div>
                    <div class="irow">
                        <span class="ilbl">Blood Group</span>
                        <span>@(Model.BloodGroup ?? "—")</span>
                    </div>
                    <div class="irow">
                        <span class="ilbl">Phone</span>
                        <span>@(Model.Phone ?? "—")</span>
                    </div>
                    <div class="irow">
                        <span class="ilbl">Emergency</span>
                        <span>@(Model.EmergencyContact ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header px-3 py-2 d-flex justify-content-between align-items-center">
                    <span>Recent Problems</span>
                    <a href="/Patient/MyComplaints" style="font-size:.79rem;color:#1e2d45;text-decoration:none;">View all</a>
                </div>
                <div class="card-body p-0">
                    @if (!recentComplaints.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-chat-square-text" style="font-size:1.8rem;opacity:.3;"></i>
                            <p class="mt-2 small mb-2">No problems submitted yet.</p>
                        </div>
                        <div class="text-center pb-3">
                            <a href="/Patient/SubmitComplaint" class="btn btn-sm btn-g">Submit a Problem</a>
                        </div>
                    }
                    else
                    {
                        <table class="table mb-0">
                            <thead>
                                <tr><th>Problem</th><th>Date</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in recentComplaints)
                                {
                                    <tr>
                                        <td>@(c.Description.Length > 45 ? c.Description[..45] + "…" : c.Description)</td>
                                        <td class="text-muted">@c.UpdatedAt.ToString("dd MMM")</td>
                                        <td>
                                            <span class="pill @(c.Status == "Active" ? "pill-a" : c.Status == "Reviewed" ? "pill-r" : "pill-d")">
                                                @c.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}
