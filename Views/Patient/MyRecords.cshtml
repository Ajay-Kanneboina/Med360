@model List<MediCore.Models.Record>
@{
    ViewData["Title"] = "My Records";
    Layout = "_PatientLayout";
}

<div class="mb-3">
    <h5 class="fw-bold mb-1" style="color:#1e2d45;">My Medical Records</h5>
    <p class="text-muted mb-0" style="font-size:.83rem;">@Model.Count record(s) on file</p>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-file-medical" style="font-size:2.5rem;opacity:.3;"></i>
        <p class="mt-3 mb-0 fw-semibold">No medical records available yet</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Diagnosis</th>
                        <th>Treatment</th>
                        <th>Doctor</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted" style="white-space:nowrap;">
                                @r.VisitDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="fw-semibold">@r.Diagnosis</td>
                            <td class="text-muted">
                                @(r.Treatment.Length > 60 ? r.Treatment[..60] + "…" : r.Treatment)
                            </td>
                            <td class="text-muted">@(r.DoctorName ?? "—")</td>
                            <td>
                                <span class="pill @(r.Status == "Active" ? "pill-r" : "pill-x")">
                                    @r.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
