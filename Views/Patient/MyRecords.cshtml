@model List<MediCore.Models.Record>
@{
    ViewData["Title"] = "My Medical Records";
    Layout = "_PatientLayout";
    string statusFilter = ViewBag.StatusFilter ?? "";
    string searchFilter = ViewBag.SearchFilter ?? "";
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int activeCount = ViewBag.ActiveCount ?? 0;
    int closedCount = ViewBag.ClosedCount ?? 0;
}

<p class="page-s">Records are added by your doctor after each visit.</p>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <div class="tile" style="padding:10px 16px;gap:8px;">
        <i class="bi bi-file-medical" style="color:#1d4ed8;"></i>
        <span style="font-size:.84rem;"><strong>@totalRecords</strong> Total</span>
    </div>
    <div class="tile" style="padding:10px 16px;gap:8px;">
        <i class="bi bi-clipboard2-pulse" style="color:#166534;"></i>
        <span style="font-size:.84rem;"><strong>@activeCount</strong> Active</span>
    </div>
    <div class="tile" style="padding:10px 16px;gap:8px;">
        <i class="bi bi-archive" style="color:#475569;"></i>
        <span style="font-size:.84rem;"><strong>@closedCount</strong> Closed</span>
    </div>
</div>

<div class="sbox mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Search</label>
            <input name="search" class="form-control" placeholder="Diagnosis, treatment or notes…" value="@searchFilter" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                <option value="Active" selected="@(statusFilter=="Active" ? "selected" : null)">Active</option>
                <option value="Closed" selected="@(statusFilter=="Closed" ? "selected" : null)">Closed</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-g w-100" style="padding:8px;">Filter</button></div>
        <div class="col-md-2"><a href="/Patient/MyRecords" class="btn btn-outline-secondary w-100">Clear</a></div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-file-medical" style="font-size:2.5rem;opacity:.3;"></i>
        <p class="mt-3 mb-0 fw-semibold">No medical records found</p>
        <p class="small mb-0">Your doctor will add records after each visit.</p>
    </div>
}
else
{
    @foreach (var r in Model)
    {
        <div class="card mb-3">
            <div class="card-header px-3 py-2 d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold" style="color:#1e2d45;">@r.Diagnosis</span>
                    <span class="pill @(r.Status=="Active" ? "pill-d" : "pill-x") ms-2">@r.Status</span>
                </div>
                <span class="text-muted" style="font-size:.8rem;">@r.VisitDate.ToString("dd MMM yyyy")</span>
            </div>
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="slabel">Treatment Plan</div>
                        <p style="font-size:.87rem;margin:0;white-space:pre-line;">@r.Treatment</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                    {
                        <div class="col-md-6">
                            <div class="slabel">Clinical Notes</div>
                            <p style="font-size:.87rem;margin:0;white-space:pre-line;">@r.Notes</p>
                        </div>
                    }
                </div>
                <div class="mt-3 pt-2" style="border-top:1px solid #f0f3f8;font-size:.8rem;color:#8faac4;">
                    <i class="bi bi-person-badge me-1"></i>Dr. @(r.DoctorName ?? "—") &nbsp;|&nbsp;
                    <i class="bi bi-calendar me-1"></i>Added @r.CreatedAt.ToString("dd MMM yyyy")
                </div>
            </div>
        </div>
    }
}
