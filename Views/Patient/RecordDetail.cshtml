@model MediCore.Models.Record
@{
    ViewData["Title"] = "Record Detail";
    Layout = "_PatientLayout";
}

<p class="page-s">Full clinical details for this visit.</p>

<div class="card mb-3">
    <div class="card-header px-3 py-2 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">@Model.Diagnosis</span>
        <span class="pill @(Model.Status=="Active" ? "pill-d" : "pill-x")">@Model.Status</span>
    </div>
    <div class="card-body p-3">
        <div class="irow">
            <span class="ilbl">Visit Date</span>
            <span>@Model.VisitDate.ToString("dd MMM yyyy")</span>
        </div>
        <div class="irow">
            <span class="ilbl">Doctor</span>
            <span>@(Model.DoctorName ?? "—")</span>
        </div>
        <div class="irow">
            <span class="ilbl">Record Added</span>
            <span>@Model.CreatedAt.ToString("dd MMM yyyy")</span>
        </div>

        <div class="mt-3">
            <div class="slabel">Treatment Plan</div>
            <p style="font-size:.87rem;white-space:pre-line;margin:0;">@Model.Treatment</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-3">
                <div class="slabel">Clinical Notes</div>
                <p style="font-size:.87rem;white-space:pre-line;margin:0;">@Model.Notes</p>
            </div>
        }
    </div>
</div>

<a href="/Patient/MyRecords" class="btn btn-sm btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Back to Records
</a>
