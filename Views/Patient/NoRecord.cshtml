@{
    ViewData["Title"] = "Account Not Linked";
    Layout = "_PatientLayout";
}

<div class="card p-5 text-center" style="max-width:500px;margin:40px auto;">
    <i class="bi bi-link-45deg" style="font-size:3rem;color:#94a3b8;"></i>
    <h5 class="mt-3 fw-bold" style="color:#1e2d45;">Account Not Linked</h5>
    <p class="text-muted" style="font-size:.86rem;">
        Your account is not linked to a patient record yet.<br />
        Please visit the reception desk to link your record.
    </p>
    <form method="post" action="/Account/Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
    </form>
</div>
