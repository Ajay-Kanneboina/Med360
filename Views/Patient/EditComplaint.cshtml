@model MediCore.Models.Complaint
@{
    ViewData["Title"] = "Edit Problem";
    Layout = "_PatientLayout";
}

<div class="mb-3">
    <h5 class="fw-bold mb-1" style="color:#1e2d45;">Update Your Problem</h5>
    <p class="text-muted mb-0" style="font-size:.83rem;">The doctor will be notified of your update.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-3">@ViewBag.Error</div>
}

<form method="post" action="/Patient/EditComplaint/@Model.Id" style="max-width:680px;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="sbox">
        <div class="slabel">Update Your Problem</div>
        <div class="mb-3">
            <label class="form-label">Main problem or symptom</label>
            <textarea name="description" class="form-control" rows="5" required>@Model.Description</textarea>
        </div>
        <div class="mb-1">
            <label class="form-label">Additional details (optional)</label>
            <textarea name="additionalNotes" class="form-control" rows="3">@Model.AdditionalNotes</textarea>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-g">Save Update</button>
        <a href="/Patient/MyComplaints" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
