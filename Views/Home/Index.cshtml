@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-h">Dashboard</div>
<p class="page-s">Welcome, @Context.Session.GetString("UserName")</p>

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="stat d-flex justify-content-between align-items-center">
            <div>
                <div class="stat-n">@ViewBag.TotalPatients</div>
                <div class="stat-l">Patients</div>
            </div>
            <i class="bi bi-people" style="font-size:1.8rem;opacity:.15;"></i>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="stat d-flex justify-content-between align-items-center">
            <div>
                <div class="stat-n">@ViewBag.TotalRecords</div>
                <div class="stat-l">Records</div>
            </div>
            <i class="bi bi-file-medical" style="font-size:1.8rem;opacity:.15;"></i>
        </div>
    </div>
</div>

<div class="mb-3">
    @if ((int? )ViewBag.PendingApprovals > 0)
    {
        <a href="/Admin/PendingUsers" class="btn btn-sm btn-warning" style="font-size:.9rem;">Pending Approvals (@ViewBag.PendingApprovals)</a>
    }
    else
    {
        <a href="/Admin/PendingUsers" class="btn btn-sm btn-outline-secondary" style="font-size:.9rem;">Pending Approvals</a>
    }
</div>
