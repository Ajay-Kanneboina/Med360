@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Register — MediCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Inter', system-ui, sans-serif;
            min-height: 100vh;
            background: linear-gradient(160deg, #f0fdfa 0%, #ccfbf1 50%, #f0fdfa 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .card-wrap {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 40px rgba(15,118,110,.12);
            width: 500px;
            overflow: hidden;
        }

        /* Top header strip */
        .card-top {
            background: linear-gradient(135deg, #0d4a45, #0f766e);
            padding: 24px 36px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .card-top-icon {
            width: 42px; height: 42px;
            background: rgba(255,255,255,.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #fff;
            flex-shrink: 0;
        }
        .card-top-text h1 {
            color: #fff;
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0 0 2px;
        }
        .card-top-text p {
            color: rgba(255,255,255,.7);
            font-size: .8rem;
            margin: 0;
        }

        /* Form body */
        .card-body-pad { padding: 28px 36px 32px; }

        .form-label { font-weight: 600; font-size: .79rem; color: #374151; margin-bottom: 4px; }
        .form-control, .form-select {
            border: 1.5px solid #d1fae5;
            border-radius: 8px;
            font-size: .87rem;
            background: #f9fffe;
            padding: 9px 12px;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15,118,110,.12);
            outline: none;
            background: #fff;
        }

        /* Section dividers inside form */
        .sec {
            font-size: .67rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .7px;
            color: #0f766e;
            border-bottom: 2px solid #ccfbf1;
            padding-bottom: 6px;
            margin: 18px 0 14px;
        }

        .btn-go {
            background: linear-gradient(135deg, #0f766e, #14b8a6);
            color: #fff;
            border: none;
            border-radius: 8px;
            width: 100%;
            padding: 11px;
            font-weight: 600;
            cursor: pointer;
            font-size: .92rem;
            letter-spacing: .2px;
            margin-top: 6px;
            transition: opacity .15s;
        }
        .btn-go:hover { opacity: .9; }

        .err  { background: #fef2f2; color: #991b1b; border-radius: 8px; padding: 9px 13px; font-size: .82rem; margin-bottom: 14px; }
        .note { background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 7px; padding: 8px 12px; font-size: .79rem; color: #0f766e; margin-top: 7px; }
    </style>
</head>
<body>

<div class="card-wrap">

    <div class="card-top">
        <img src="/images/logo.svg" width="42" height="42" style="border-radius:50%;flex-shrink:0;" />
        <div class="card-top-text">
            <h1>MediCore360</h1>
            <p>Healthcare & Patient Management</p>
        </div>
    </div>

    <div class="card-body-pad">
        <div style="margin-bottom:18px;">
            <div style="font-size:1.05rem;font-weight:700;color:#134e4a;">Create your account</div>
            <div style="font-size:.82rem;color:#94a3b8;margin-top:2px;">Fill in the details below to get started</div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="err"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="sec">Personal Details</div>
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control" placeholder="e.g. Kunal Rathod" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Phone Number </label>
                <input type="tel" name="phone" class="form-control" placeholder="e.g. +91 98765 43210" />
            </div>
            <div class="mb-1">
                <label class="form-label">Role</label>
                <select name="role" class="form-select" required>
                    <option value="">— Select your role —</option>
                    <option value="Patient">Patient</option>
                    <option value="Doctor">Doctor</option>
                    <option value="Nurse">Nurse</option>
                    <option value="Receptionist">Receptionist</option>
                </select>
                <div class="note">
                    <i class="bi bi-info-circle me-1"></i>
                    Patients: use the same email registered at the clinic to link your records automatically.
                </div>
            </div>

            <div class="sec">Set Password</div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Min. 6 characters" required minlength="6" />
                </div>
                <div class="col-6">
                    <label class="form-label">Confirm</label>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter" required />
                </div>
            </div>

            <button type="submit" class="btn-go">
                <i class="bi bi-person-check me-1"></i> Create Account
            </button>

            <div class="text-center mt-3" style="font-size:.81rem;color:#94a3b8;">
                Already have an account?
                <a href="/Account/Login" style="color:#0f766e;font-weight:600;text-decoration:none;">Sign in</a>
            </div>
        </form>
    </div>

</div>

</body>
</html>
