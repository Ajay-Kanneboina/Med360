@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign In — MediCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Inter', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            background: #f0fdfa;
        }

        /* ── Left panel ── */
        .left {
            flex: 1;
            background: linear-gradient(145deg, #0d4a45 0%, #0f766e 60%, #14b8a6 100%);
            padding: 56px 52px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .left::before {
            content: '';
            position: absolute;
            top: -80px; right: -80px;
            width: 320px; height: 320px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }
        .left::after {
            content: '';
            position: absolute;
            bottom: -60px; left: -60px;
            width: 240px; height: 240px;
            border-radius: 50%;
            background: rgba(255,255,255,.04);
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 40px;
            letter-spacing: .3px;
        }
        .brand-icon {
            width: 36px; height: 36px;
            background: rgba(255,255,255,.15);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }
        .left h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 12px;
            line-height: 1.35;
        }
        .left p { opacity: .75; font-size: .88rem; line-height: 1.75; max-width: 340px; }
        .feat { list-style: none; padding: 0; margin-top: 30px; }
        .feat li {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: .84rem;
            opacity: .8;
            margin-bottom: 13px;
        }
        .feat li .fi {
            width: 30px; height: 30px;
            background: rgba(255,255,255,.12);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* ── Right panel ── */
        .right {
            flex: 1;
            background: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 52px 44px;
            box-shadow: 4px 0 30px rgba(0,0,0,.06);
        }
        .right-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            color: #0f766e;
            font-size: .95rem;
            margin-bottom: 28px;
        }
        .right h2 { font-size: 1.2rem; font-weight: 700; color: #134e4a; margin-bottom: 4px; }
        .right .sub { font-size: .82rem; color: #94a3b8; margin-bottom: 24px; }

        .form-label { font-weight: 600; font-size: .79rem; color: #374151; }
        .form-control {
            border: 1.5px solid #d1fae5;
            border-radius: 8px;
            font-size: .88rem;
            background: #f9fffe;
            padding: 10px 13px;
        }
        .form-control:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15,118,110,.12);
            outline: none;
            background: #fff;
        }
        .btn-go {
            background: linear-gradient(135deg, #0f766e, #14b8a6);
            color: #fff;
            border: none;
            border-radius: 8px;
            width: 100%;
            padding: 11px;
            font-weight: 600;
            cursor: pointer;
            font-size: .92rem;
            letter-spacing: .2px;
            transition: opacity .15s;
        }
        .btn-go:hover { opacity: .9; }
        .err { background: #fef2f2; color: #991b1b; border-radius: 8px; padding: 9px 13px; font-size: .82rem; margin-bottom: 14px; }
        .ok  { background: #f0fdf4; color: #166534; border-radius: 8px; padding: 9px 13px; font-size: .82rem; margin-bottom: 14px; }
        .divider { border: none; border-top: 1px solid #f0fdf9; margin: 20px 0; }
    </style>
</head>
<body>

<div class="right">
    <div class="right-brand">
        <img src="/images/logo.svg" width="22" height="22" style="border-radius:50%;" /> MediCore360
    </div>
    <h2>Welcome back</h2>
    <p class="sub">Sign in to your account to continue</p>

    @if (ViewBag.Error != null)
    {
        <div class="err"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="ok"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="err"><i class="bi bi-info-circle me-1"></i>@TempData["Info"]</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Email address</label>
            <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
        </div>
        <div class="mb-4">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" required />
        </div>
        <button type="submit" class="btn-go">Sign In &nbsp;<i class="bi bi-arrow-right"></i></button>
    </form>

    <hr class="divider" />
    <div class="text-center" style="font-size:.81rem;color:#94a3b8;">
        Don't have an account?
        <a href="/Account/Register" style="color:#0f766e;font-weight:600;text-decoration:none;">Create one</a>
    </div>
</div>

<div class="left">
    <div class="brand">
        <img src="/images/logo.svg" width="36" height="36" style="border-radius:50%;flex-shrink:0;" />
        MediCore360
    </div>
    <h1>Your health, managed in one place</h1>
    <p>A secure platform connecting patients, doctors, and healthcare staff for seamless medical care.</p>
    <ul class="feat">
        <li>
            <div class="fi"><i class="bi bi-file-medical-fill"></i></div>
            Complete medical history at a glance
        </li>
        <li>
            <div class="fi"><i class="bi bi-chat-square-heart-fill"></i></div>
            Submit problems, get doctor responses
        </li>
        <li>
            <div class="fi"><i class="bi bi-people-fill"></i></div>
            Role-based access for all staff
        </li>
        <li>
            <div class="fi"><i class="bi bi-shield-lock-fill"></i></div>
            HIPAA-compliant, secure & private
        </li>
    </ul>
</div>

</body>
</html>
