@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign In — MediCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { margin:0; font-family:'Segoe UI',sans-serif; min-height:100vh; display:flex; }
        .left { flex:1; background:#1e2d45; padding:56px 48px; display:flex; flex-direction:column; justify-content:center; color:#fff; }
        .left h1 { font-size:1.8rem; font-weight:700; margin-bottom:10px; line-height:1.3; }
        .left p  { opacity:.7; font-size:.88rem; line-height:1.7; max-width:360px; }
        .brand   { display:flex; align-items:center; gap:8px; font-weight:700; margin-bottom:32px; }
        .feat    { list-style:none; padding:0; margin-top:26px; }
        .feat li { display:flex; align-items:center; gap:10px; font-size:.83rem; opacity:.75; margin-bottom:10px; }
        .right   { width:380px; background:#f6f7fb; display:flex; flex-direction:column; justify-content:center; padding:48px 40px; }
        .right h2 { font-size:1.1rem; font-weight:700; color:#1e2d45; margin-bottom:4px; }
        .right p  { font-size:.82rem; color:#94a3b8; margin-bottom:22px; }
        .form-label { font-weight:600; font-size:.79rem; color:#4a5568; }
        .form-control { border:1px solid #dde3ee; border-radius:7px; font-size:.88rem; background:#fff; }
        .form-control:focus { border-color:#1e2d45; box-shadow:0 0 0 3px rgba(30,45,69,.1); outline:none; }
        .btn-go { background:#1e2d45; color:#fff; border:none; border-radius:7px; width:100%; padding:10px; font-weight:600; cursor:pointer; font-size:.9rem; }
        .btn-go:hover { background:#162336; }
        .err { background:#fef2f2; color:#991b1b; border-radius:7px; padding:9px 12px; font-size:.82rem; margin-bottom:12px; }
        .ok  { background:#f0fdf4; color:#166534; border-radius:7px; padding:9px 12px; font-size:.82rem; margin-bottom:12px; }
    </style>
</head>
<body>
<div class="left">
    <div class="brand"><i class="bi bi-heart-pulse-fill text-danger fs-5"></i> MediCore</div>
    <h1>Connecting patients and doctors</h1>
    <p>Submit health problems, get doctor responses, and view your medical records — all in one place.</p>
    <ul class="feat">
        <li><i class="bi bi-chat-square-text"></i> Submit and update health problems</li>
        <li><i class="bi bi-reply"></i> Doctors respond directly</li>
        <li><i class="bi bi-file-medical"></i> View complete medical history</li>
        <li><i class="bi bi-shield-check"></i> Secure and private</li>
    </ul>
</div>
<div class="right">
    <h2>Sign In</h2>
    <p>Enter your credentials to continue</p>
    @if (ViewBag.Error != null)
    {
        <div class="err"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="ok"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
    }
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required />
        </div>
        <div class="mb-4">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required />
        </div>
        <button type="submit" class="btn-go">Sign In</button>
        <div class="text-center mt-3" style="font-size:.81rem;color:#94a3b8;">
            No account? <a href="/Account/Register" style="color:#1e2d45;font-weight:600;text-decoration:none;">Register</a>
        </div>
    </form>
</div>
</body>
</html>
