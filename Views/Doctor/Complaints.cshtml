@model List<MediCore.Models.Complaint>
@{
    ViewData["Title"] = "Patient Complaints";
    string filter = ViewBag.Filter ?? "all";
    int unread = (int)(ViewBag.UnreadCount ?? 0);
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="page-h">Patient Complaints</div>
        <p class="page-s">@Model.Count result(s)</p>
    </div>
    @if (unread > 0)
    {
        <span class="pill pill-a px-3 py-2" style="font-size:.82rem;">
            <i class="bi bi-envelope-exclamation me-1"></i>@unread unread
        </span>
    }
</div>

<div class="mb-3 d-flex gap-2">
    <a href="/Doctor/Complaints" class="btn btn-sm @(filter == "all" ? "btn-primary" : "btn-outline-secondary")">All</a>
    <a href="/Doctor/Complaints?filter=unread" class="btn btn-sm @(filter == "unread" ? "btn-primary" : "btn-outline-secondary")">Unread</a>
    <a href="/Doctor/Complaints?filter=active" class="btn btn-sm @(filter == "active" ? "btn-primary" : "btn-outline-secondary")">Active</a>
    <a href="/Doctor/Complaints?filter=reviewed"class="btn btn-sm @(filter == "reviewed" ? "btn-primary" : "btn-outline-secondary")">Reviewed</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-chat-square-text" style="font-size:2.5rem;opacity:.3;"></i>
                <p class="mt-3 mb-0 fw-semibold">No complaints found</p>
            </div>
        }
        else
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Problem</th>
                        <th>Submitted</th>
                        <th>Updated</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="@(!c.IsRead ? "unread-row" : "")">
                            <td>
                                <div class="fw-semibold">@c.Patient?.FullName</div>
                                @if (!c.IsRead)
                                {
                                    <span class="new-badge">● NEW</span>
                                }
                            </td>
                            <td style="max-width:280px;">
                                @(c.Description.Length > 75 ? c.Description[..75] + "…" : c.Description)
                            </td>
                            <td class="text-muted">@c.SubmittedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-muted">@c.UpdatedAt.ToString("dd MMM, hh:mm tt")</td>
                            <td>
                                @if (c.Status == "Active") { <span class="pill pill-a">@c.Status</span> }
                                else if (c.Status == "Reviewed") { <span class="pill pill-r">@c.Status</span> }
                                else { <span class="pill pill-d">@c.Status</span> }
                            </td>
                            <td>
                                <a href="/Doctor/ViewComplaint/@c.Id"
                                   class="btn btn-sm btn-outline-primary" style="font-size:.8rem;">
                                    View &amp; Respond
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
